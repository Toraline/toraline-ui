{
  "name": "@toraline/tokens",
  "version": "2.0.0-alpha.0",
  "private": true,
  "description": "Design tokens and themes of the Toraline component library.",
  "type": "module",
  "sideEffects": false,
  "files": ["dist"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
