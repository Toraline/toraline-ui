{
  "name": "@toraline.tech/tokens",
  "version": "2.0.0-beta.0",
  "description": "Design tokens and themes of the Toraline component library.",
  "keywords": [
    "toraline",
    "design-tokens",
    "css-variables",
    "theme",
    "dark-mode",
    "tailwindcss"
  ],
  "homepage": "https://github.com/Toraline/toraline-ui/tree/v2/packages/tokens#readme",
  "bugs": {
    "url": "https://github.com/Toraline/toraline-ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Toraline/toraline-ui.git",
    "directory": "packages/tokens"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./css": "./css/index.css",
    "./css/primitives.css": "./css/primitives.css",
    "./css/themes/light.css": "./css/themes/light.css",
    "./css/themes/dark.css": "./css/themes/dark.css",
    "./css/tailwind.css": "./css/tailwind.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit --emitDeclarationOnly false",
    "prepack": "npm run build",
    "prepublishOnly": "node ../../scripts/check-packages.mjs --publish"
  },
  "peerDependencies": {
    "tailwindcss": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  }
}
