{
  "name": "@toraline/tokens",
  "version": "2.0.0-alpha.0",
  "private": true,
  "description": "Design tokens and themes of the Toraline component library.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./css": "./css/index.css",
    "./css/primitives.css": "./css/primitives.css",
    "./css/themes/light.css": "./css/themes/light.css",
    "./css/themes/dark.css": "./css/themes/dark.css",
    "./css/tailwind.css": "./css/tailwind.css"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit --emitDeclarationOnly false"
  },
  "peerDependencies": {
    "tailwindcss": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  }
}
