{
  "name": "@toraline.tech/ui",
  "version": "0.1.0",
  "description": "Styled React components of the Toraline component library.",
  "keywords": [
    "toraline",
    "react",
    "components",
    "ui",
    "design-system",
    "nextjs",
    "tailwindcss"
  ],
  "homepage": "https://github.com/Toraline/toraline-ui/tree/main/packages/ui#readme",
  "bugs": {
    "url": "https://github.com/Toraline/toraline-ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Toraline/toraline-ui.git",
    "directory": "packages/ui"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "default": "./dist/theme/index.js"
    },
    "./styles.css": "./css/styles.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit --emitDeclarationOnly false",
    "prepack": "npm run build",
    "prepublishOnly": "node ../../scripts/check-packages.mjs --publish"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@toraline.tech/tokens": "0.1.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
