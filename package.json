{
  "name": "toraline-ui-monorepo",
  "private": true,
  "description": "Monorepo of the Toraline component library: tokens, styled components, catalog.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "eslint": "^10.15.0",
    "jsdom": "31.0.1",
    "postcss": "8.5.33",
    "tailwindcss": "4.3.5",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
